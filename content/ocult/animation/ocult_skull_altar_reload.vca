@configure fps 24 rotation-order ZYX
@scale bone skull by x curve bezier {
    @key frame 0 value 0 lx 0 ly 0 rx 25.31184 ry -0.03604
    @key frame 36 value 1 lx -12.37776 ly -0.01441 rx 0 ry 0
}
@scale bone skull by y curve bezier {
    @key frame 0 value 0 lx 0 ly 0 rx 26.8824 ry 0.05045
    @key frame 36 value 1 lx -12.37776 ly -0.01441 rx 0 ry 0
}
@scale bone skull by z curve bezier {
    @key frame 0 value 0 lx 0 ly 0 rx 26.8824 ry 0.05045
    @key frame 36 value 1 lx -12.37776 ly -0.01441 rx 0 ry 0
}
@rotate bone banner by y curve bezier {
    @key frame 0 value 0 lx 0 ly 0 rx 18.2904 ry 2.16867
    @key frame 30 value 359 lx -12.10056 ly 0 rx 0 ry 0
}
