<!-- Bottom command panel, StarCraft/Warcraft style. Filled by ocult:rts/command_panel.
     The background is textures/ui-bg.png (806x170, preload.json); the panel has
     its size and the parts sit inside its frame (dark area x 36..768, y 36..170) -->
<container size="806,170" z-index="-2" color="#00000000"
           position-func="gui.get_viewport()[1] / 2 - 403, gui.get_viewport()[2] - 170">
    <image src="ui-bg" pos="0,0" size="806,170" interactive="false"/>
    <!-- 3D preview of the selected object (modelviewer), see command_panel -->
    <container id="portrait" pos="44,38" size="130,130" color="#00000000"/>
    <container id="info" pos="184,38" size="340,130" color="#00000000">
        <label id="sel_title" pos="0,0" size="340,24" color="#e0c8d0FF"></label>
        <label id="sel_desc" pos="0,30" size="340,100" multiline="true" text-wrap="true"
               color="#a08890FF"></label>
    </container>
    <container id="commands" pos="532,36" size="230,130" color="#00000000"/>
</container>
